# Supabase project URL. Scripts accept either name.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Read-only key for local checks such as check_debit_dates.py.
# Prefer this over service_role for scripts that only SELECT public data.
SUPABASE_ANON_KEY=

# Server-side only. Required by maintenance/update scripts that write to Supabase.
SUPABASE_SERVICE_ROLE_KEY=
